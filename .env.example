# Never commit actual credentials. Configure these in the deployment environment.
# IMD requires public-IP allow-listing and real station IDs for every district.
IMD_AWS_URL_TEMPLATE=https://city.imd.gov.in/api/aws_data_api.php?id={station_id}
IMD_STATION_MAP={"uttarkashi":"IMD_STATION_ID"}

# Set only after CWC/NWIC grants programmatic gauge-feed access.
# The endpoint response must expose: discharge, river_discharge, flow_m3s, or q.
CWC_GAUGE_URL_TEMPLATE=https://your-approved-cwc-gateway.example/gauges/{gauge_id}
CWC_GAUGE_MAP={"uttarkashi":"CWC_GAUGE_ID"}
CWC_BEARER_TOKEN=
